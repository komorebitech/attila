<div class="extra-pagination">
  {{pagination}}
</div>

{{#foreach posts}}

  <article class="{{post_class}}">
    <div class="inner">
      <div class="box post-box">
        <a href="{{url}}" style="text-decoration: none; color:inherit;">
          <h2 class="post-title">{{{title}}}</h2>
        </a>
        <span class="post-meta">{{t "By"}}
          {{authors separator=", "}}
          {{#primary_tag}}{{t "in"}}
            <a class="post-meta-tag" href="{{url}}">{{name}}</a>{{/primary_tag}}
          {{t "on "}}
          <time datetime="{{date format="DD-MM-YYYY"}}">{{date
              format="DD MMM YYYY"
            }}</time>
        </span>

        <a href="{{url}}" style="text-decoration: none; color:inherit;"><p
            class="post-excerpt"
          >{{excerpt}}&hellip;</p></a>
      </div>
    </div>
  </article>

{{/foreach}}

{{pagination}}